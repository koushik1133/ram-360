# Mapbox public token (https://account.mapbox.com/)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# Supabase project (https://supabase.com/dashboard) - optional, app works with mock data without it
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional CDN base for heavy assets (glb / panos). Leave empty to serve from /public
NEXT_PUBLIC_ASSET_CDN=

# Optional CRM webhook that receives lead form submissions
LEAD_WEBHOOK_URL=
